{
  "name": "disconnect",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "husky",
    "web": "pnpm --dir src/apps/client dev",
    "web:build": "pnpm --dir src/apps/client build",
    "web:lint": "pnpm --dir src/apps/client lint",
    "server": "node -e \"const{spawnSync:s}=require('child_process'),p=require('path'),c=p.resolve('src/apps/server');s('cmd',['/c',p.join(c,'gradlew.bat'),'bootRun'],{cwd:c,stdio:'inherit'})\"",
    "server:build": "node -e \"const{spawnSync:s}=require('child_process'),p=require('path'),c=p.resolve('src/apps/server');s('cmd',['/c',p.join(c,'gradlew.bat'),'build'],{cwd:c,stdio:'inherit'})\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "husky": "^9",
    "lint-staged": "^15"
  }
}
