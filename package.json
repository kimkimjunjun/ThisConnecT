{
  "name": "disconnect",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "cd .. && husky disconnect/.husky",
    "web": "pnpm --dir src/apps/client dev",
    "web:build": "pnpm --dir src/apps/client build",
    "web:lint": "pnpm --dir src/apps/client lint",
    "server": "cd src/apps/server && gradlew.bat bootRun",
    "server:build": "cd src/apps/server && gradlew.bat build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "husky": "^9",
    "lint-staged": "^15"
  }
}
