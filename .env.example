# Client (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Kakao OAuth
NEXT_PUBLIC_KAKAO_CLIENT_ID=your-kakao-rest-api-key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/callback/kakao

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/callback/google

# Server (Spring Boot) - prod only
DATABASE_URL=jdbc:postgresql://localhost:5432/disconnectdb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
JWT_SECRET=your-jwt-secret-key
